{
  "expo": {
    "name": "AGROBRIDGE",
    "slug": "AGROBRIDGE",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon_1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon_1024.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.agrobridge.app",
      "versionCode": 2,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2eb67fd5-2848-4522-b319-5fbb94f929b5"
      }
    },
    "owner": "meetbindal_team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2eb67fd5-2848-4522-b319-5fbb94f929b5",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification_icon.png",
          "color": "#F5A623",
          "defaultChannel": "agrobridge"
        }
      ],
      "expo-sharing"
    ]
  }
}
