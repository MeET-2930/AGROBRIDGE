  outlineText: { color: Colors.error, fontWeight: '800' },
  primary: { flex: 1, backgroundColor: Colors.primary, borderRadius: 8, height: 42, alignItems: 'center', justifyContent: 'center', flexDirection: 'row', gap: 6 },
  secondary: { flex: 1, backgroundColor: Colors.secondary, borderRadius: 8, height: 42, alignItems: 'center', justifyContent: 'center' },
  primaryText: { color: Colors.white, fontWeight: '800' },
