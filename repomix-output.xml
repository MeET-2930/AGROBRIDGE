import React, { useCallback, useState } from 'react';
import { View, Text, StyleSheet, SafeAreaView, ScrollView, TouchableOpacity, Modal, TextInput, Alert, RefreshControl } from 'react-native';
import { useFocusEffect } from '@react-navigation/native';
import { Ionicons } from '@expo/vector-icons';
import AppHeader from '../../components/AppHeader';
import PrimaryButton from '../../components/PrimaryButton';
import Colors from '../../theme/colors';
import { fetchTodaysQueue, markAppeared, markNoShow } from '../../services/bookings';
import { useLang } from '../../i18n/LanguageContext';

export default function TodaysQueueScreen({ navigation }) {
  const { tr } = useLang();
  const [queue, setQueue] = useState([]);
  const [refreshing, setRefreshing] = useState(false);
  const [modal, setModal] = useState(false);
  const [selected, setSelected] = useState(null);
  const [vehicle, setVehicle] = useState('');

  const load = async () => setQueue(await fetchTodaysQueue('centre-1'));
  useFocusEffect(useCallback(() => { load(); }, []));

  const onRefresh = async () => {
    setRefreshing(true); await load(); setRefreshing(false);
  };

  const openArrive = (token) => {
    setSelected(token);
    setVehicle('');
    setModal(true);
  };

  const confirmArrive = async () => {
    await markAppeared(selected.tokenId, vehicle);
    setModal(false);
    load();
  };

  const noShow = (tokenId) => {
    Alert.alert('अनुपस्थित?', 'क्या किसान नहीं आया?', [
      { text: 'रद्द', style: 'cancel' },
      { text: 'हाँ', style: 'destructive', onPress: async () => { await markNoShow(tokenId); load(); } },
    ]);
  };

  const active = queue.filter((q) => q.status !== 'paid' && q.status !== 'no-show');

  return (
    <SafeAreaView style={styles.container}>
      <AppHeader navigation={navigation} showBack audioKey="audio_officer_queue" title={tr('gateQueue') || 'गेट कतार'} />
      <ScrollView contentContainerStyle={styles.content} refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} />}>
        {active.length === 0 ? <Text style={styles.empty}>कतार खाली है</Text> : active.map((token) => (
          <View key={token.tokenId} style={styles.card}>
            <View style={styles.top}>
              <Text style={styles.token}>{token.tokenNumber}</Text>
              <Text style={styles.time}>{token.estimatedTurnTime}</Text>
            </View>
            <Text style={styles.name}>{token.farmerName}</Text>
            <Text style={styles.sub}>{String(token.crop || '').toUpperCase()} • {token.vehicleNumber || 'वाहन लंबित'}</Text>
            <View style={styles.actions}>
              {token.status === 'booked' ? (
                <>
                  <TouchableOpacity style={styles.outline} onPress={() => noShow(token.tokenId)}>
                    <Text style={styles.outlineText}>{tr('markNoShow') || 'अनुपस्थित'}</Text>
                  </TouchableOpacity>
                  <TouchableOpacity style={styles.primary} onPress={() => openArrive(token)}>
                    <Ionicons name="enter-outline" size={16} color={Colors.white} />
                    <Text style={styles.primaryText}>{tr('markArrived') || 'आगमन'}</Text>
                  </TouchableOpacity>
                </>
              ) : (
                <TouchableOpacity style={styles.secondary} onPress={() => navigation.navigate('MarkPaid', { token })}>
                  <Text style={styles.primaryText}>{tr('processPayment') || 'भुगतान'}</Text>
                </TouchableOpacity>
              )}
            </View>
          </View>
        ))}
      </ScrollView>

      <Modal visible={modal} transparent animationType="fade">
        <View style={styles.overlay}>
          <View style={styles.sheet}>
            <Text style={styles.sheetTitle}>{tr('enterVehicle') || 'वाहन नंबर'}</Text>
            <Text style={styles.sheetSub}>टोकन {selected?.tokenNumber}</Text>
            <TextInput style={styles.input} value={vehicle} onChangeText={setVehicle} placeholder="PB 10 CQ 4521" autoCapitalize="characters" />
            <View style={styles.sheetRow}>
              <TouchableOpacity onPress={() => setModal(false)}><Text style={styles.cancel}>{tr('cancel') || 'रद्द'}</Text></TouchableOpacity>
              <PrimaryButton title={tr('confirmArrival') || 'पुष्टि'} onPress={confirmArrive} style={{ flex: 1, height: 44 }} />
            </View>
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}
const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: Colors.background },
  content: { padding: 16 },
  empty: { textAlign: 'center', marginTop: 40, color: Colors.subText },
  card: { backgroundColor: Colors.white, borderRadius: 12, padding: 16, marginBottom: 12, borderWidth: 1, borderColor: Colors.border },
  top: { flexDirection: 'row', justifyContent: 'space-between' },
  token: { fontSize: 22, fontWeight: '900', color: Colors.navy },
