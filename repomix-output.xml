  useLang,
} from '../../i18n/LanguageContext';

import {
  fetchActiveFarmerBooking,
} from '../../services/bookings';

import {
  getCurrentUserSession,
  logoutUserSession,
} from '../../services/auth';

export default function FarmerDashboard({
  navigation,
}) {
  const { tr } = useLang();

  const [
    activeBooking,
    setActiveBooking,
  ] = useState(null);

  const [
    session,
    setSession,
  ] = useState(null);

  const [
    refreshing,
    setRefreshing,
  ] = useState(false);

  const [
    profileOpen,
    setProfileOpen,
  ] = useState(false);

  const load = async () => {
    const user =
      await getCurrentUserSession();

    setSession(user);

    if (user?.uid) {
      const booking =
        await fetchActiveFarmerBooking(
          user.uid
        );

      setActiveBooking(
        booking
      );
    } else {
      setActiveBooking(null);
    }
  };

  useFocusEffect(
    useCallback(() => {
      load();
    }, [])
  );

  const onRefresh = async () => {
    setRefreshing(true);

    await load();

    setRefreshing(false);
  };

  const logout = async () => {
    setProfileOpen(false);

    await logoutUserSession();

    navigation
      .getParent()
      ?.reset({
        index: 0,
        routes: [
          {
            name: 'Auth',
          },
        ],
      });
  };

  return (
    <SafeAreaView
