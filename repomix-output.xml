        <ScreenTitle
          title="भुगतान रसीदें"
          subtitle="बैंक/ऋण के लिए आधिकारिक रसीद"
        />

        {loading ? (
          <ActivityIndicator
            color={Colors.primary}
            size="large"
            style={{
              marginTop: 30,
            }}
          />
        ) : list.length === 0 ? (
          <Text
            style={styles.empty}
          >
            अभी कोई भुगतान नहीं
          </Text>
        ) : (
          list.map((payment) => (
            <View
              key={
                payment.tokenId
              }
              style={styles.card}
            >
              <Text
                style={styles.id}
              >
                {payment.receiptId}
              </Text>

              <Text
                style={styles.centre}
              >
                {payment.centreName}
              </Text>

              <Text
                style={styles.row}
              >
                टोकन:{' '}
                {payment.tokenNumber}
              </Text>

              <Text
                style={styles.row}
              >
                मात्रा:{' '}
                {payment.actualQuantity}{' '}
                क्विंटल
              </Text>

              <Text
                style={styles.row}
              >
                ग्रेड: {payment.grade}{' '}
