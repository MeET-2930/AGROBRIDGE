<file path="screens/officer/MarkPaidScreen.js">
import React, { useState } from 'react';
import { View, Text, TextInput, StyleSheet, SafeAreaView, ScrollView, Alert } from 'react-native';
import AppHeader from '../../components/AppHeader';
import ScreenTitle from '../../components/ScreenTitle';
import PrimaryButton from '../../components/PrimaryButton';
import Colors from '../../theme/colors';
import { QUALITY_GRADES, MOCK_CENTRES } from '../../services/centres';
import { markPaid } from '../../services/bookings';

export default function MarkPaidScreen({ navigation, route }) {
  const { token } = route.params || {};
  const centre = MOCK_CENTRES.find((c) => c.id === token?.centreId) || MOCK_CENTRES[0];
  const [qty, setQty] = useState(token?.approxQuantityQuintals ? String(token.approxQuantityQuintals) : '40');
  const [rate, setRate] = useState('2275');
  const [grade, setGrade] = useState('FAQ');
  const [loading, setLoading] = useState(false);

  const q = parseFloat(qty) || 0;
  const r = parseFloat(rate) || 0;
  const gross = q * r;
  const deductions = gross * ((centre.mandiFeePercent + centre.commissionPercent) / 100) + q * centre.hamaliPerQuintal;
  const net = gross - deductions;

  const submit = async () => {
    try {
      setLoading(true);
      await markPaid(token.tokenId, { actualQuantity: qty, ratePerQuintal: rate, grade });
      Alert.alert('सफल', 'रसीद जनरेट हो गई', [{ text: 'OK', onPress: () => navigation.goBack() }]);
    } catch (e) {
      Alert.alert('त्रुटि', e.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <SafeAreaView style={styles.container}>
      <AppHeader navigation={navigation} showBack />
      <ScrollView contentContainerStyle={styles.content}>
        <ScreenTitle title="भुगतान अंतिम" subtitle={`टोकन ${token?.tokenNumber} • ${token?.farmerName}`} />
        <Text style={styles.label}>वास्तविक तौल (क्विंटल)</Text>
        <TextInput style={styles.input} keyboardType="numeric" value={qty} onChangeText={setQty} />
        <Text style={styles.label}>ग्रेड</Text>
        <View style={styles.grades}>
          {QUALITY_GRADES.map((g) => (
            <Text key={g.id} onPress={() => setGrade(g.id)} style={[styles.grade, grade === g.id && styles.gradeOn]}>{g.name}</Text>
          ))}
        </View>
        <Text style={styles.label}>दर प्रति क्विंटल (₹)</Text>
        <TextInput style={styles.input} keyboardType="numeric" value={rate} onChangeText={setRate} />
        <View style={styles.preview}>
          <Text style={styles.previewTitle}>कटौती सहित गणना</Text>
          <Text style={styles.previewRow}>कुल: ₹{gross.toFixed(2)}</Text>
          <Text style={styles.previewNet}>नेट देय: ₹{net.toFixed(2)}</Text>
        </View>
      </ScrollView>
      <View style={styles.footer}>
        <PrimaryButton title="आधिकारिक रसीद बनाएं" loading={loading} onPress={submit} />
      </View>
    </SafeAreaView>
  );
}
const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: Colors.background },
  content: { padding: 20 },
  label: { fontWeight: '700', color: Colors.navy, marginTop: 12, marginBottom: 6 },
  input: { backgroundColor: Colors.white, borderWidth: 1, borderColor: Colors.border, borderRadius: 10, height: 48, paddingHorizontal: 12 },
  grades: { flexDirection: 'row', flexWrap: 'wrap', gap: 8 },
  grade: { paddingHorizontal: 12, paddingVertical: 8, borderRadius: 20, borderWidth: 1, borderColor: Colors.border, overflow: 'hidden', color: Colors.subText },
  gradeOn: { backgroundColor: Colors.primaryLight, borderColor: Colors.primary, color: Colors.primary, fontWeight: '800' },
  preview: { marginTop: 18, backgroundColor: Colors.navyLight, borderRadius: 12, padding: 14 },
  previewTitle: { fontWeight: '800', color: Colors.navy, marginBottom: 8 },
  previewRow: { color: Colors.navy, marginBottom: 4 },
  previewNet: { fontWeight: '900', color: Colors.secondary, fontSize: 16, marginTop: 4 },
  footer: { padding: 20, backgroundColor: Colors.white, borderTopWidth: 1, borderTopColor: Colors.border },
