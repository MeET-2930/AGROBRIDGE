            onRefresh={refresh}
            colors={[
              Colors.primary,
            ]}
          />
        }
      >
        <ScreenTitle
          title="इतिहास"
          subtitle="आपकी सभी मंडी बुकिंग"
        />

        {loading ? (
          <ActivityIndicator
            color={Colors.primary}
            size="large"
            style={{
              marginTop: 30,
            }}
          />
        ) : list.length === 0 ? (
          <View
            style={styles.empty}
          >
            <Text
              style={
                styles.emptyTitle
              }
            >
              अभी कोई बुकिंग नहीं है।
            </Text>

            <Text
              style={styles.emptySub}
            >
              आपकी नई बुकिंग यहां दिखाई
              देगी।
            </Text>
          </View>
        ) : (
          list.map((item) => (
            <TouchableOpacity
              key={item.tokenId}
              style={styles.card}
              onPress={() =>
                navigation.navigate(
                  'TokenDetail',
                  {
                    tokenId:
                      item.tokenId,
                  }
                )
              }
            >
              <View
                style={styles.top}
              >
                <Text
                  style={styles.token}
                >
                  {item.tokenNumber}
                </Text>

                <StatusBadge
                  status={
                    item.status
                  }
                />
              </View>

              <Text
                style={styles.centre}
              >
                {item.centreName}
              </Text>

              <Text
                style={styles.crop}
              >
                फसल: {item.crop}
              </Text>

              <Text
                style={styles.sub}
              >
                {item.date} •{' '}
                {item.slotWindow}
              </Text>

              {item.vehicleNumber ? (
                <Text
                  style={styles.sub}
                >
                  वाहन: {
                    item.vehicleNumber
                  }
                </Text>
              ) : null}

              <Text
                style={styles.view}
              >
                विवरण देखें →
              </Text>
            </TouchableOpacity>
          ))
        )}
      </ScrollView>
    </SafeAreaView>
  );
}

