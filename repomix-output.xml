import React, {
  useEffect,
  useState,
} from 'react';

import {
  View,
  Text,
  StyleSheet,
  SafeAreaView,
  ScrollView,
  TouchableOpacity,
  ActivityIndicator,
  Alert,
} from 'react-native';

import AppHeader from '../../components/AppHeader';
import ScreenTitle from '../../components/ScreenTitle';
import PrimaryButton from '../../components/PrimaryButton';
import Colors from '../../theme/colors';

import {
  fetchCentreSlots,
  createBooking,
} from '../../services/bookings';

import {
  getCurrentUserSession,
} from '../../services/auth';

import { useLang } from '../../i18n/LanguageContext';

export default function SlotSelectionScreen({
  navigation,
  route,
}) {
  const { tr } = useLang();

  const {
    crop,
    centre,
  } = route.params || {};

  const today =
    new Date()
      .toISOString()
      .split('T')[0];

  const [date, setDate] =
    useState(today);

  const [slots, setSlots] =
    useState([]);

  const [selected, setSelected] =
    useState(null);

  const [loading, setLoading] =
    useState(true);

  const [submitting, setSubmitting] =
    useState(false);

  const [quantity, setQuantity] =
    useState('');

  const loadSlots = async () => {
    if (!centre?.id) {
      setSlots([]);
      setSelected(null);
      setLoading(false);
      return;
    }

    setLoading(true);

    try {
      const result =
        await fetchCentreSlots(
          centre.id,
          date
        );

      const availableSlots =
        result?.slots || [];

      setSlots(
        availableSlots
      );

      setSelected(
        availableSlots.find(
          (slot) =>
            !slot.isFull
        ) ||
          availableSlots[0] ||
          null
      );
    } catch (error) {
      console.error(
        'Slot loading error:',
        error
      );

      setSlots([]);
      setSelected(null);

      Alert.alert(
        'स्लॉट लोड नहीं हुए',
        error?.message ||
          'कृपया दोबारा प्रयास करें।'
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadSlots();
  }, [date, centre?.id]);

  const confirm = async () => {
    if (!selected) {
      Alert.alert(
        'स्लॉट चुनें',
        'कृपया एक स्लॉट चुनें।'
      );
      return;
    }

    if (selected.isFull) {
      Alert.alert(
        'स्लॉट पूरा है',
        'यह स्लॉट उपलब्ध नहीं है। कृपया दूसरा स्लॉट चुनें।'
      );
      return;
    }

    const session =
      await getCurrentUserSession();

    if (!session?.uid) {
      Alert.alert(
        'लॉग इन आवश्यक',
        'कृपया दोबारा लॉग इन करें।'
      );
      return;
    }

    if (
      !quantity ||
      Number(quantity) <= 0
    ) {
      Alert.alert(
        'मात्रा',
        'कृपया अनुमानित मात्रा दर्ज करें।'
      );
      return;
    }

    setSubmitting(true);

    try {
      const booking =
        await createBooking({
          farmerId:
            session.uid,

          farmerName:
            session.name,

          farmerPhone:
            session.phone,

          centreId:
            centre.id,

          crop:
            crop.id,

          approxQuantityQuintals:
            Number(quantity),

          date,

          slotTime:
            selected.slotTime,

          slotWindow:
            selected.windowLabel,

          joinWaitlistIfFull:
            false,
        });

      navigation.reset({
        index: 0,
        routes: [
          {
            name:
              'TokenConfirmation',
            params: {
              booking,
            },
          },
        ],
      });
    } catch (error) {
      console.error(
        'Booking error:',
        error
      );

      Alert.alert(
        'बुकिंग असफल',
        error?.message ||
          'बुकिंग करते समय समस्या हुई।'
      );
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <SafeAreaView
      style={styles.container}
    >
      <AppHeader
        navigation={navigation}
        showBack
        audioKey="audio_slot"
      />

      <ScrollView
        contentContainerStyle={
          styles.content
        }
      >
        <ScreenTitle
          title={
            tr('selectSlot') ||
            'आगमन समय'
          }
          subtitle={
            centre?.name ||
            'मंडी'
          }
        />

        <Text
          style={styles.sectionTitle}
        >
          तारीख चुनें
        </Text>

        <View style={styles.dates}>
          {[0, 1, 2].map(
            (offset) => {
              const d =
                new Date();

              d.setDate(
                d.getDate() +
                  offset
              );

              const dateString =
                d.toISOString()
                  .split('T')[0];

              const isSelected =
                date ===
                dateString;

              return (
                <TouchableOpacity
                  key={
                    dateString
                  }
                  style={[
                    styles.dateChip,
                    isSelected &&
                      styles.dateOn,
                  ]}
                  onPress={() =>
                    setDate(
                      dateString
                    )
                  }
                >
                  <Text
                    style={[
                      styles.dateText,
                      isSelected &&
                        styles.dateTextOn,
                    ]}
                  >
                    {offset === 0
                      ? 'आज'
                      : offset === 1
                      ? 'कल'
                      : d.getDate()}
                  </Text>

                  {offset > 1 ? (
                    <Text
                      style={[
                        styles.dateSmall,
                        isSelected &&
                          styles.dateTextOn,
                      ]}
                    >
                      {d.toLocaleDateString(
                        'hi-IN',
                        {
                          month:
                            'short',
                        }
                      )}
                    </Text>
                  ) : null}
                </TouchableOpacity>
              );
            }
          )}
        </View>

        <Text
          style={styles.sectionTitle}
        >
          स्लॉट चुनें
        </Text>

        {loading ? (
          <ActivityIndicator
            color={Colors.primary}
            size="large"
            style={{
              marginTop: 20,
            }}
          />
        ) : slots.length === 0 ? (
          <View
            style={styles.empty}
          >
            <Text
              style={
                styles.emptyText
              }
            >
              इस दिन कोई स्लॉट उपलब्ध
              नहीं है।
            </Text>
          </View>
        ) : (
          slots.map((slot) => {
            const isSelected =
              selected?.slotTime ===
              slot.slotTime;

            return (
              <TouchableOpacity
                key={
                  slot.slotTime
                }
                style={[
                  styles.slot,
                  isSelected &&
                    styles.slotOn,
                ]}
                onPress={() =>
                  setSelected(slot)
                }
              >
                <View
                  style={{
                    flex: 1,
                  }}
                >
                  <Text
                    style={
                      styles.slotTitle
                    }
                  >
                    {
                      slot.windowLabel
                    }
                  </Text>

                  <Text
                    style={
                      styles.slotSub
                    }
                  >
                    {slot.isFull
                      ? 'क्षमता पूरी'
                      : `${
                          slot.availableCapacity
                        } / ${
                          slot.totalCapacity
                        } स्थान उपलब्ध`}
                  </Text>
                </View>

                {isSelected ? (
                  <Text
                    style={
                      styles.selectedText
                    }
                  >
                    ✓
                  </Text>
                ) : null}
              </TouchableOpacity>
            );
          })
        )}

        <Text
          style={styles.sectionTitle}
        >
          अनुमानित मात्रा
        </Text>

        <View
          style={styles.quantityBox}
        >
          <Text
            style={styles.quantityLabel}
          >
            फसल की मात्रा
          </Text>

          <View
            style={styles.quantityInputRow}
          >
            <TouchableOpacity
              style={
                styles.quantityButton
              }
              onPress={() =>
                setQuantity(
                  String(
                    Math.max(
                      0,
                      Number(
                        quantity ||
                          0
                      ) - 1
                    )
                  )
                )
              }
            >
              <Text
                style={
                  styles.quantityButtonText
                }
              >
                −
              </Text>
            </TouchableOpacity>

            <Text
              style={
                styles.quantityValue
              }
            >
              {quantity || '0'}
            </Text>

            <TouchableOpacity
              style={
                styles.quantityButton
              }
              onPress={() =>
                setQuantity(
                  String(
                    Number(
                      quantity ||
                        0
                    ) + 1
                  )
                )
              }
            >
              <Text
                style={
                  styles.quantityButtonText
                }
              >
                +
              </Text>
            </TouchableOpacity>
          </View>

          <Text
            style={
              styles.quantityUnit
            }
          >
            क्विंटल
          </Text>
        </View>
      </ScrollView>

      <View
        style={styles.footer}
      >
        <PrimaryButton
          loading={submitting}
          title={
            tr('confirmToken') ||
            'टोकन लें'
          }
          onPress={confirm}
          disabled={
            !selected ||
            loading ||
            submitting
          }
        />
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor:
      Colors.background,
  },

  content: {
    padding: 20,
    paddingBottom: 35,
  },

  sectionTitle: {
    fontSize: 15,
    fontWeight: '800',
    color: Colors.navy,
    marginTop: 8,
    marginBottom: 10,
  },

  dates: {
    flexDirection: 'row',
