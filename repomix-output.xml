import AsyncStorage from '@react-native-async-storage/async-storage';
import { db } from './firebase';
import {
  doc,
  setDoc,
  getDoc,
  serverTimestamp,
} from 'firebase/firestore';

const SESSION_KEY = '@agrobridge_user_session';

let currentUserSession = null;

export const OFFICER_DUTIES = [
  {
    id: 'gate',
    name: 'गेट अधिकारी (Gate Entry)',
    desc: 'गेट आगमन और वाहन प्रविष्टि',
  },
  {
    id: 'weighbridge',
    name: 'तौल एवं ग्रेडिंग (Assay)',
    desc: 'वजन माप और गुणवत्ता',
  },
  {
    id: 'accounts',
    name: 'लेखा व भुगतान (Cashier)',
    desc: 'भुगतान और बैंक रसीद',
  },
  {
    id: 'admin',
    name: 'मंडी प्रशासक (Admin)',
    desc: 'समस्त नियंत्रण व विलंब प्रबंधन',
  },
];

function normalizePhone(phone) {
  return String(phone || '')
    .replace(/\D/g, '')
    .slice(-10);
}

function buildSession(uid, userData) {
  return {
    uid,
    phone: userData.phone || uid,
    role: userData.role || 'farmer',
    name: userData.name || '',
    employeeId: userData.employeeId || '',
    officerDuty: userData.officerDuty || '',
    licenseNumber: userData.licenseNumber || '',
    businessName: userData.businessName || '',
    isVerified: userData.isVerified || false,
  };
}

async function saveSession(session) {
  currentUserSession = session;
  await AsyncStorage.setItem(
    SESSION_KEY,
    JSON.stringify(session)
  );
}

/**
 * Login using the user's registered mobile number.
 *
 * OTP is currently handled by the frontend test flow.
 * Real Firebase Phone Authentication will be connected later.
 */
export async function loginWithPhone(
  phone,
  role = 'farmer'
) {
  try {
    const normalizedPhone = normalizePhone(phone);

    if (normalizedPhone.length !== 10) {
      throw new Error(
        'कृपया सही 10 अंकों का मोबाइल नंबर दर्ज करें।'
      );
    }

    const userDocRef = doc(
      db,
      'users',
      normalizedPhone
    );

    const userSnap = await getDoc(userDocRef);

    if (!userSnap.exists()) {
      throw new Error(
        'इस मोबाइल नंबर से कोई खाता नहीं मिला। पहले पंजीकरण करें।'
      );
    }

    const userData = userSnap.data();

    if (userData.role !== role) {
      throw new Error(
        `यह मोबाइल नंबर ${userData.role} खाते के लिए पंजीकृत है।`
      );
    }

    const session = buildSession(
      userSnap.id,
      userData
    );

    await saveSession(session);

    return session;
  } catch (error) {
    console.error('Login Error:', error);
    throw error;
  }
}

/**
 * Register a new user in Firestore.
 */
export async function registerUser({
  role,
  name,
  phone,
  employeeId = '',
  officerDuty = 'admin',
  licenseNumber = '',
  businessName = '',
}) {
  try {
    const normalizedPhone = normalizePhone(phone);

    if (!name?.trim()) {
      throw new Error('नाम दर्ज करें।');
    }

    if (normalizedPhone.length !== 10) {
      throw new Error(
        'कृपया सही 10 अंकों का मोबाइल नंबर दर्ज करें।'
      );
    }

    const userDocRef = doc(
      db,
      'users',
      normalizedPhone
    );

    const userSnap = await getDoc(userDocRef);

    if (userSnap.exists()) {
      throw new Error(
        'इस मोबाइल नंबर से खाता पहले से मौजूद है। कृपया लॉग इन करें।'
      );
    }

    if (
      role === 'officer' &&
      !employeeId?.trim()
    ) {
      throw new Error(
        'कर्मचारी आईडी दर्ज करें।'
      );
    }

    if (
      role === 'trader' &&
      (!licenseNumber?.trim() ||
        !businessName?.trim())
    ) {
      throw new Error(
        'लाइसेंस नंबर और फर्म नाम दर्ज करें।'
      );
    }

    const newUser = {
      phone: normalizedPhone,
      role,
      name: name.trim(),

      employeeId:
        role === 'officer'
          ? employeeId.trim()
          : null,

      officerDuty:
        role === 'officer'
          ? officerDuty
          : null,

      licenseNumber:
        role === 'trader'
          ? licenseNumber.trim()
          : null,

      businessName:
        role === 'trader'
          ? businessName.trim()
          : null,

      createdAt: serverTimestamp(),

      isVerified: false,
    };

    await setDoc(
      userDocRef,
      newUser
    );

    const session = buildSession(
      normalizedPhone,
      {
        ...newUser,
        createdAt: null,
      }
    );

    await saveSession(session);

    return session;
  } catch (error) {
    console.error(
      'Registration Error:',
      error
    );

    throw error;
  }
}

/**
 * Restore the previous login when the app starts.
 */
export async function restoreUserSession() {
  try {
    const stored =
      await AsyncStorage.getItem(
        SESSION_KEY
      );

    if (!stored) {
      currentUserSession = null;
      return null;
    }

    const session =
      JSON.parse(stored);

    if (
      !session?.uid ||
      !session?.role
    ) {
      await AsyncStorage.removeItem(
        SESSION_KEY
      );

      currentUserSession = null;
      return null;
    }

    currentUserSession = session;

    return session;
  } catch (error) {
    console.error(
      'Session restore error:',
      error
    );

    currentUserSession = null;
    return null;
  }
}

export async function getCurrentUserSession() {
  return currentUserSession;
}

export async function logoutUserSession() {
  currentUserSession = null;

  await AsyncStorage.removeItem(
    SESSION_KEY
  );

  return true;
}
</file>

<file path="services/bookings.js">
import { db } from './firebase';
import {
  collection,
  doc,
  setDoc,
  getDoc,
  getDocs,
  query,
  where,
  updateDoc,
  serverTimestamp,
} from 'firebase/firestore';

import { fetchCentreById } from './centres';

function formatHour(hour) {
  const ampm = hour >= 12 ? 'PM' : 'AM';
  const hour12 = hour % 12 === 0 ? 12 : hour % 12;

  return `${hour12}:00 ${ampm}`;
}

function todayString() {
  return new Date().toISOString().split('T')[0];
}

/**
 * Fetch available booking slots for a centre.
 */
export async function fetchCentreSlots(centreId, dateStr) {
  const centre = await fetchCentreById(centreId);

  if (!centre) {
    throw new Error('Mandi centre not found');
  }

  const capacityPerWindow = Math.max(
    1,
    Math.floor(
      (60 / centre.avgMinutesPerEntry) * centre.parallelLanes
    )
  );

  const bookingsQuery = query(
    collection(db, 'bookings'),
    where('centreId', '==', centreId),
    where('date', '==', dateStr)
  );

  const snapshot = await getDocs(bookingsQuery);

  const bookings = snapshot.docs
    .map((item) => item.data())
    .filter((booking) => booking.status !== 'cancelled');

  const [startHour] = centre.operatingStartTime
    .split(':')
    .map(Number);

  const [endHour] = centre.operatingEndTime
    .split(':')
    .map(Number);

  const slots = [];

  for (let hour = startHour; hour < endHour; hour++) {
    const slotTime = `${String(hour).padStart(2, '0')}:00`;

    const bookedCount = bookings.filter(
      (booking) => booking.slotTime === slotTime
    ).length;

    const availableCapacity = Math.max(
      0,
      capacityPerWindow - bookedCount
    );

    slots.push({
      slotTime,
      windowLabel: `${formatHour(hour)} - ${formatHour(hour + 1)}`,
      totalCapacity: capacityPerWindow,
      bookedCount,
      availableCapacity,
      isFull: availableCapacity === 0,
    });
  }

  return {
    centre,
    date: dateStr,
    slots,
  };
}

/**
 * Create a farmer booking.
 */
export async function createBooking({
  farmerId,
  farmerName,
  farmerPhone,
  centreId,
  crop,
  vehicleNumber = '',
  approxQuantityQuintals = 0,
  date,
  slotTime,
  slotWindow,
  joinWaitlistIfFull = false,
}) {
  if (!farmerId) {
    throw new Error('Farmer ID is required');
  }

  if (!centreId) {
    throw new Error('Mandi centre is required');
  }

  if (!crop) {
    throw new Error('Crop is required');
  }

  if (!date || !slotTime) {
    throw new Error('Date and slot are required');
  }

  const centre = await fetchCentreById(centreId);

  if (!centre) {
    throw new Error('Mandi centre not found');
  }

  const bookingsQuery = query(
    collection(db, 'bookings'),
    where('centreId', '==', centreId),
    where('date', '==', date)
  );

  const snapshot = await getDocs(bookingsQuery);

  const existingBookings = snapshot.docs.map((item) => item.data());

  const activeBookings = existingBookings.filter(
    (booking) => booking.status !== 'cancelled'
  );

  const positionAssigned = activeBookings.length + 1;

  const tokenLetter = String.fromCharCode(
    65 + Math.floor((positionAssigned - 1) / 20)
  );

  const tokenNumber = `${tokenLetter}-${String(
    ((positionAssigned - 1) % 20) + 1
  ).padStart(2, '0')}`;

  const tokenId = `TKN-${Date.now()}`;

  const quantity =
    parseFloat(approxQuantityQuintals) || 0;

  const [slotHour, slotMinute] = slotTime
    .split(':')
    .map(Number);

  const estimatedTurn = new Date();

  estimatedTurn.setHours(
    slotHour,
    (slotMinute || 0) +
      (positionAssigned % 3) *
        centre.avgMinutesPerEntry,
    0,
    0
  );

  const estimatedTurnTime =
    estimatedTurn.toLocaleTimeString([], {
      hour: '2-digit',
      minute: '2-digit',
      hour12: true,
    });

  const booking = {
    tokenId,
    tokenNumber,
    positionAssigned,

    farmerId,
    farmerName: farmerName || '',
    farmerPhone: farmerPhone || '',

    vehicleNumber: vehicleNumber
      ? vehicleNumber.toUpperCase().trim()
      : '',

    approxQuantityQuintals: quantity,

    centreId,
    centreName: centre.name,
    centreAddress: centre.address,

    crop,

    date,
    slotTime,
    slotWindow:
      slotWindow || `${slotTime} Window`,

    status: joinWaitlistIfFull
      ? 'waitlisted'
      : 'booked',

    isWaitlisted: !!joinWaitlistIfFull,

    estimatedTurnTime,

    actualAppearedTime: null,

    delayOffsetMinutes: 0,
    delayReason: '',

    actualQuantity: null,
    ratePerQuintal: null,
    grade: null,

    grossAmount: null,
    mandiFee: null,
    commission: null,
    hamali: null,
    netPayable: null,

    receiptId: null,
    receiptGeneratedAt: null,

    createdAt: new Date().toISOString(),
  };

  await setDoc(
    doc(db, 'bookings', tokenId),
    booking
  );

  return booking;
}

/**
 * Fetch all bookings belonging to a farmer.
 */
export async function fetchMyBookings(farmerId) {
  if (!farmerId) return [];

  try {
    const bookingsQuery = query(
      collection(db, 'bookings'),
      where('farmerId', '==', farmerId)
    );

    const snapshot = await getDocs(bookingsQuery);

    return snapshot.docs
      .map((item) => item.data())
      .sort(
        (a, b) =>
          new Date(b.createdAt || 0) -
          new Date(a.createdAt || 0)
      );
  } catch (error) {
    console.error(
      'Error fetching farmer bookings:',
      error
    );

    return [];
  }
}

/**
 * Fetch farmer's current active booking.
 */
export async function fetchActiveFarmerBooking(farmerId) {
  if (!farmerId) return null;

  try {
    const bookingsQuery = query(
      collection(db, 'bookings'),
      where('farmerId', '==', farmerId),
      where('status', 'in', [
        'booked',
        'appeared',
        'payment-processing',
      ])
    );

    const snapshot = await getDocs(bookingsQuery);

    if (snapshot.empty) {
      return null;
    }

    const active =
      snapshot.docs
        .map((item) => item.data())
        .sort(
          (a, b) =>
            new Date(b.createdAt || 0) -
            new Date(a.createdAt || 0)
        )[0];

    const queueQuery = query(
      collection(db, 'bookings'),
      where('centreId', '==', active.centreId),
      where('date', '==', active.date)
    );

    const queueSnapshot =
      await getDocs(queueQuery);

    const queue = queueSnapshot.docs
      .map((item) => item.data())
      .filter((booking) =>
        ['booked', 'appeared', 'payment-processing'].includes(
          booking.status
        )
      );

    const queuePositionAhead = queue.filter(
      (booking) =>
        booking.positionAssigned <
        active.positionAssigned
    ).length;

    return {
      ...active,
      queuePositionAhead,
    };
  } catch (error) {
    console.error(
      'Error fetching active booking:',
      error
    );

    return null;
  }
}

/**
 * Fetch one token.
 */
export async function fetchTokenDetail(tokenId) {
  if (!tokenId) return null;

  try {
    const snapshot = await getDoc(
      doc(db, 'bookings', tokenId)
    );

    if (!snapshot.exists()) {
      return null;
    }

    return snapshot.data();
  } catch (error) {
    console.error(
      'Error fetching token:',
      error
    );

    return null;
  }
}

/**
 * Officer: today's queue.
 */
export async function fetchTodaysQueue(
  centreId,
  dateStr = null
) {
  if (!centreId) return [];

  try {
    const date = dateStr || todayString();

    const queueQuery = query(
      collection(db, 'bookings'),
      where('centreId', '==', centreId),
      where('date', '==', date)
    );

    const snapshot = await getDocs(queueQuery);

    return snapshot.docs
      .map((item) => item.data())
      .sort(
        (a, b) =>
          (a.positionAssigned || 0) -
          (b.positionAssigned || 0)
      );
  } catch (error) {
    console.error(
      'Error fetching queue:',
      error
    );

    return [];
  }
}

/**
 * Officer: mark farmer as arrived.
 */
export async function markAppeared(
  tokenId,
  vehicleNumber = ''
) {
  if (!tokenId) {
    throw new Error('Token ID is required');
  }

  const bookingRef = doc(
    db,
    'bookings',
    tokenId
  );

  const snapshot = await getDoc(bookingRef);

  if (!snapshot.exists()) {
    throw new Error('Token not found');
  }

  const updatePayload = {
    status: 'payment-processing',
    actualAppearedTime:
      new Date().toLocaleTimeString([], {
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
      }),
  };

  if (vehicleNumber.trim()) {
    updatePayload.vehicleNumber =
      vehicleNumber.toUpperCase().trim();
  }

  await updateDoc(
    bookingRef,
    updatePayload
  );

  const updated =
    await getDoc(bookingRef);

  return updated.data();
}

/**
 * Officer: complete weighing/payment.
 */
export async function markPaid(
  tokenId,
  {
    actualQuantity,
    ratePerQuintal,
    grade,
  }
) {
  if (!tokenId) {
    throw new Error('Token ID is required');
  }

  const bookingRef = doc(
    db,
    'bookings',
    tokenId
  );

  const snapshot =
    await getDoc(bookingRef);

  if (!snapshot.exists()) {
    throw new Error('Token not found');
  }

  const booking = snapshot.data();

  const centre =
    await fetchCentreById(
      booking.centreId
    );

  if (!centre) {
    throw new Error('Mandi centre not found');
  }

  const quantity =
    parseFloat(actualQuantity);

  const rate =
    parseFloat(ratePerQuintal);

  if (!quantity || quantity <= 0) {
    throw new Error(
      'Valid quantity is required'
    );
  }

  if (!rate || rate <= 0) {
    throw new Error(
      'Valid rate is required'
    );
  }

  const gross =
    quantity * rate;

  const mandiFee =
    gross *
    ((centre.mandiFeePercent || 0) / 100);

  const commission =
    gross *
    ((centre.commissionPercent || 0) / 100);

  const hamali =
    quantity *
    (centre.hamaliPerQuintal || 0);

  const netPayable =
    gross -
    mandiFee -
    commission -
    hamali;

  const receiptId =
    `RCP-${new Date().getFullYear()}-${Math.floor(
      10000 + Math.random() * 90000
    )}`;

  const updatePayload = {
    status: 'paid',

    actualQuantity: quantity,
    ratePerQuintal: rate,
    grade: grade || 'FAQ',

    grossAmount:
      Math.round(gross * 100) / 100,

    mandiFee:
      Math.round(mandiFee * 100) / 100,

    commission:
      Math.round(commission * 100) / 100,

    hamali:
      Math.round(hamali * 100) / 100,

    netPayable:
      Math.round(netPayable * 100) / 100,

    receiptId,

    receiptGeneratedAt:
      new Date().toISOString(),
  };

  await updateDoc(
    bookingRef,
    updatePayload
  );

  const updated =
    await getDoc(bookingRef);

  return updated.data();
}

/**
 * Officer: mark no-show.
 */
export async function markNoShow(tokenId) {
  if (!tokenId) {
    throw new Error('Token ID is required');
  }

  const bookingRef = doc(
    db,
    'bookings',
    tokenId
  );

  await updateDoc(
    bookingRef,
    {
      status: 'no-show',
      noShowAt: serverTimestamp(),
    }
  );

  return true;
}

/**
 * Report centre delay.
 */
export async function reportCentreDelay(
  centreId,
  delayMinutes,
  reason
) {
  if (!centreId) {
    throw new Error('Centre ID is required');
  }

  const minutes =
    parseInt(delayMinutes, 10) || 0;

  await setDoc(
    doc(db, 'delays', centreId),
    {
      centreId,
      minutes,
      reason:
        reason || 'Operational Delay',
      updatedAt: serverTimestamp(),
    }
  );

  return true;
}

/**
 * Officer dashboard summary.
 */
export async function fetchOfficerSummary(
  centreId,
  dateStr = null
) {
  if (!centreId) {
    return {
      total: 0,
      pending: 0,
      appeared: 0,
      paid: 0,
      noShows: 0,
      totalProcuredQuintals: 0,
      totalDisbursedRs: 0,
      centreDelay: {
        minutes: 0,
        reason: '',
      },
    };
  }

  try {
    const date =
      dateStr || todayString();

    const queueQuery = query(
      collection(db, 'bookings'),
      where('centreId', '==', centreId),
      where('date', '==', date)
    );

    const snapshot =
      await getDocs(queueQuery);

    const bookings =
      snapshot.docs.map(
        (item) => item.data()
      );

    const paid =
      bookings.filter(
        (booking) =>
          booking.status === 'paid'
      );

    return {
      total: bookings.length,

      pending: bookings.filter(
        (booking) =>
          booking.status === 'booked'
      ).length,

      appeared: bookings.filter(
        (booking) =>
          [
            'appeared',
            'payment-processing',
            'paid',
          ].includes(booking.status)
      ).length,

      paid: paid.length,

      noShows: bookings.filter(
        (booking) =>
          booking.status === 'no-show'
      ).length,

      totalProcuredQuintals:
        Math.round(
          paid.reduce(
            (sum, booking) =>
              sum +
              (booking.actualQuantity || 0),
            0
          ) * 10
        ) / 10,

      totalDisbursedRs:
        Math.round(
          paid.reduce(
            (sum, booking) =>
              sum +
              (booking.netPayable || 0),
            0
          )
        ),

      centreDelay: {
        minutes: 0,
        reason: '',
      },
    };
  } catch (error) {
    console.error(
      'Error fetching officer summary:',
      error
    );

    return {
      total: 0,
      pending: 0,
      appeared: 0,
      paid: 0,
      noShows: 0,
      totalProcuredQuintals: 0,
      totalDisbursedRs: 0,
      centreDelay: {
        minutes: 0,
        reason: '',
      },
    };
  }
}
