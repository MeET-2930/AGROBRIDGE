<file path="screens/auth/OtpScreen.js">
import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  StyleSheet,
  SafeAreaView,
  Alert,
  ActivityIndicator,
} from 'react-native';

import AppHeader from '../../components/AppHeader';
import ScreenTitle from '../../components/ScreenTitle';
import PrimaryButton from '../../components/PrimaryButton';
import Colors from '../../theme/colors';

import {
  loginWithPhone,
  registerUser,
} from '../../services/auth';

export default function OtpScreen({
  navigation,
  route,
}) {
  const p = route?.params || {};

  const [otp, setOtp] =
    useState('1234');

  const [loading, setLoading] =
    useState(false);

  const handleVerify = async () => {
    if (otp !== '1234') {
      Alert.alert(
        'गलत OTP',
        'टेस्ट मोड में OTP 1234 है।'
      );
      return;
    }

    setLoading(true);

    try {
      let session;

      if (p.isNewRegistration) {
        session =
          await registerUser({
            role: p.role,
            name: p.name,
            phone: p.phone,
            employeeId:
              p.employeeId,
            officerDuty:
              p.officerDuty,
            licenseNumber:
              p.licenseNumber,
            businessName:
              p.businessName,
          });
      } else {
        session =
          await loginWithPhone(
            p.phone,
            p.role
          );
      }

      if (session.role === 'officer') {
        navigation
          .getParent()
          ?.reset({
            index: 0,
            routes: [
              {
                name: 'Officer',
              },
            ],
          });

        return;
      }

      if (session.role === 'trader') {
        navigation
          .getParent()
          ?.reset({
            index: 0,
            routes: [
              {
                name: 'Trader',
              },
            ],
          });

        return;
      }

      navigation
        .getParent()
        ?.reset({
          index: 0,
          routes: [
            {
              name: 'Farmer',
            },
          ],
        });
    } catch (error) {
      Alert.alert(
        'समस्या',
        error?.message ||
          'कुछ गलत हो गया। कृपया दोबारा प्रयास करें।'
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <SafeAreaView
      style={styles.container}
    >
      <AppHeader
        navigation={navigation}
        showBack
      />

      <View style={styles.content}>
        <ScreenTitle
          title="ओटीपी सत्यापन"
          subtitle={`+91 ${
            p.phone || ''
          }`}
        />

        <Text style={styles.testText}>
          टेस्ट मोड: OTP 1234
        </Text>

        <TextInput
          style={styles.otp}
          keyboardType="number-pad"
          maxLength={4}
          value={otp}
          onChangeText={(text) =>
            setOtp(
              text.replace(/\D/g, '')
            )
          }
          editable={!loading}
        />

        {loading ? (
          <ActivityIndicator
            color={Colors.primary}
            style={{
              marginTop: 20,
            }}
          />
        ) : (
          <PrimaryButton
            title="पुष्टि करें और आगे बढ़ें"
            onPress={handleVerify}
            disabled={
              otp.length !== 4
            }
            style={{
              marginTop: 20,
            }}
          />
        )}
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: Colors.background,
  },

  content: {
    flex: 1,
    padding: 20,
  },

  testText: {
    textAlign: 'center',
    color: Colors.subText,
    fontSize: 12,
    marginTop: 14,
  },

  otp: {
    marginTop: 20,
    alignSelf: 'center',
    width: 180,
    height: 56,
    borderWidth: 2,
    borderColor: Colors.primary,
    borderRadius: 12,
    textAlign: 'center',
    fontSize: 28,
    fontWeight: '800',
    letterSpacing: 10,
    backgroundColor: Colors.white,
    color: Colors.navy,
  },
});
</file>

