import React, {
  useCallback,
  useState,
} from 'react';

import {
  View,
  Text,
  StyleSheet,
  SafeAreaView,
  ScrollView,
  ActivityIndicator,
  RefreshControl,
} from 'react-native';

import {
  useFocusEffect,
} from '@react-navigation/native';

import AppHeader from '../../components/AppHeader';
import ScreenTitle from '../../components/ScreenTitle';
import Colors from '../../theme/colors';

import {
  fetchMyBookings,
} from '../../services/bookings';

import {
  getCurrentUserSession,
} from '../../services/auth';

export default function PaymentsScreen({
  navigation,
}) {
  const [list, setList] =
    useState([]);

  const [loading, setLoading] =
    useState(true);

  const [refreshing, setRefreshing] =
    useState(false);

  const loadPayments = async () => {
    try {
      const session =
        await getCurrentUserSession();

      if (!session?.uid) {
        setList([]);
        return;
      }

      const bookings =
        await fetchMyBookings(
          session.uid
        );

      setList(
        bookings.filter(
          (item) =>
            item.status === 'paid'
        )
      );
    } catch (error) {
      console.error(
        'Payments error:',
        error
      );

      setList([]);
    } finally {
      setLoading(false);
    }
  };

  useFocusEffect(
    useCallback(() => {
      loadPayments();
    }, [])
  );

  const refresh = async () => {
    setRefreshing(true);

    await loadPayments();

    setRefreshing(false);
  };

  return (
    <SafeAreaView
      style={styles.container}
    >
      <AppHeader
        navigation={navigation}
        showBack
      />

      <ScrollView
        contentContainerStyle={
          styles.content
        }
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={refresh}
            colors={[
              Colors.primary,
            ]}
          />
        }
