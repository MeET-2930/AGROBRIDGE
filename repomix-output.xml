            }
          >
            <Ionicons
              name="person"
              size={24}
              color={Colors.white}
            />
          </TouchableOpacity>

          <View
            style={{
              flex: 1,
            }}
          >
            <Text style={styles.greet}>
              {tr('namaste') ||
                'नमस्ते'} 🙏
            </Text>

            <Text style={styles.name}>
              {session?.name ||
                'किसान'}
            </Text>

            <Text style={styles.phone}>
              +91 {session?.phone || ''}
            </Text>
          </View>
        </View>

        {activeBooking ? (
          <View
            style={styles.statusCard}
          >
            <View
              style={styles.statusTop}
            >
              <View>
                <Text
                  style={
                    styles.statusLabel
                  }
                >
                  {tr(
                    'activeBooking'
                  ) ||
                    'सक्रिय बुकिंग'}
                </Text>

                <Text
                  style={styles.token}
                >
                  {
                    activeBooking.tokenNumber
                  }
                </Text>
              </View>

              <StatusBadge
                status={
                  activeBooking.status
                }
              />
            </View>

            <Text style={styles.meta}>
              {
                activeBooking.centreName
              }
            </Text>

            <Text style={styles.meta}>
              {
                activeBooking.slotWindow
              }
            </Text>

            <Text
              style={
                styles.metaBold
              }
            >
              {tr(
                'vehiclesAhead'
              ) ||
                'आगे वाहन'}:{' '}
              {
                activeBooking.queuePositionAhead ||
                0
              }
            </Text>

            <Text
              style={
                styles.metaBold
              }
            >
              {tr('estTurn') ||
                'अनुमानित बारी'}:{' '}
              {
                activeBooking.estimatedTurnTime
              }
            </Text>

            <PrimaryButton
              title={
                tr(
                  'trackStatus'
                ) || 'गेट स्थिति'
              }
              style={{
                marginTop: 12,
                height: 44,
              }}
              onPress={() =>
                navigation.navigate(
                  'TokenDetail',
                  {
                    tokenId:
                      activeBooking.tokenId,
                  }
                )
              }
            />
          </View>
        ) : (
          <View
            style={styles.emptyCard}
          >
            <Text
              style={
                styles.emptyTitle
              }
            >
              {tr(
                'noActiveBooking'
              ) ||
                'कोई सक्रिय बुकिंग नहीं'}
            </Text>

            <TouchableOpacity
              onPress={() =>
                navigation.navigate(
                  'CropSelection'
                )
              }
            >
              <Text
                style={styles.link}
              >
                {tr(
                  'bookASlot'
                ) ||
                  'स्लॉट बुक करें →'}
              </Text>
            </TouchableOpacity>
          </View>
        )}

        <View style={styles.grid}>
          <DashboardCard
            title={
              tr('bookSlot') ||
              'स्लॉट बुक'
            }
            icon="calendar-outline"
            onPress={() =>
              navigation.navigate(
                'CropSelection'
              )
            }
          />

          <DashboardCard
            title={
              tr('myToken') ||
              'मेरा टोकन'
            }
            icon="ticket-outline"
            onPress={() =>
              activeBooking
                ? navigation.navigate(
                    'TokenDetail',
                    {
                      tokenId:
                        activeBooking.tokenId,
                    }
                  )
                : navigation.navigate(
                    'History'
                  )
            }
          />

          <DashboardCard
            title={
              tr('payments') ||
              'भुगतान'
            }
            icon="receipt-outline"
            onPress={() =>
              navigation.navigate(
                'Payments'
              )
            }
          />

          <DashboardCard
            title={
              tr('history') ||
              'इतिहास'
            }
            icon="time-outline"
            onPress={() =>
              navigation.navigate(
                'History'
              )
            }
          />

          <DashboardCard
            title={
              tr('myCrops') ||
              'फसलें'
            }
            icon="leaf-outline"
            onPress={() =>
              navigation.navigate(
                'CropSelection'
              )
            }
          />

          <DashboardCard
            title={
              tr('help') ||
              'सहायता'
            }
            icon="help-circle-outline"
            onPress={() => {}}
          />
        </View>
      </ScrollView>

      <Modal
        visible={profileOpen}
        transparent
        animationType="fade"
      >
        <Pressable
          style={styles.overlay}
          onPress={() =>
            setProfileOpen(false)
          }
        >
          <View
            style={styles.modal}
          >
            <Text
              style={styles.profileName}
            >
              {session?.name ||
                'किसान'}
            </Text>

            <Text
              style={styles.profilePhone}
            >
              +91 {session?.phone ||
                ''}
            </Text>

            <TouchableOpacity
              style={
                styles.logoutBtn
              }
              onPress={logout}
            >
              <Ionicons
                name="log-out-outline"
                size={20}
                color={Colors.error}
              />

              <Text
                style={
                  styles.logoutText
                }
              >
                {tr('logout') ||
                  'लॉग आउट'}
              </Text>
            </TouchableOpacity>
          </View>
        </Pressable>
      </Modal>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor:
      Colors.background,
  },

  content: {
