<file path="components/StatusBadge.js">
import React from 'react';
import { View, Text, StyleSheet } from 'react-native';

export default function StatusBadge({ status }) {
  let bg = '#FFF8E1';
  let color = '#F57F17';
  let label = String(status || '').toUpperCase();

  if (status === 'booked') {
    bg = '#FFF8E1'; color = '#F57F17'; label = 'बुक / BOOKED';
  } else if (status === 'appeared' || status === 'payment-processing') {
    bg = '#E3F2FD'; color = '#1976D2'; label = 'मंडी में / IN PROCESS';
  } else if (status === 'paid') {
    bg = '#E8F5E9'; color = '#2E7D32'; label = 'भुगतान / PAID';
  } else if (status === 'no-show') {
    bg = '#FFEBEE'; color = '#C62828'; label = 'अनुपस्थित';
  } else if (status === 'waitlisted') {
    bg = '#EDE7F6'; color = '#5E35B1'; label = 'प्रतीक्षा';
  }

  return (
    <View style={[styles.badge, { backgroundColor: bg }]}>
      <Text style={[styles.text, { color }]}>{label}</Text>
    </View>
  );
}

const styles = StyleSheet.create({
  badge: { paddingHorizontal: 10, paddingVertical: 4, borderRadius: 8, alignSelf: 'flex-start' },
  text: { fontSize: 11, fontWeight: '800' },
});
</file>

<file path="i18n/LanguageContext.js">
import React, { createContext, useContext, useMemo, useState, useCallback } from 'react';
import * as Speech from 'expo-speech';
import { translate, LANGUAGES } from './translations';

const LanguageContext = createContext(null);

const SPEECH_LANG = { hi: 'hi-IN', en: 'en-IN', pa: 'pa-IN', mr: 'mr-IN', gu: 'gu-IN' };

export function LanguageProvider({ children }) {
  const [lang, setLang] = useState('hi'); // Hindi default
  const [pickerOpen, setPickerOpen] = useState(false);

  const tr = useCallback((key) => String(translate(key, lang) || ''), [lang]);

  const speak = useCallback((keyOrText, isRaw = false) => {
    const text = isRaw ? String(keyOrText || '') : translate(keyOrText, lang);
    if (!text) return;
    Speech.stop();
    Speech.speak(String(text), { language: SPEECH_LANG[lang] || 'hi-IN', rate: 0.9 });
  }, [lang]);

  const stopSpeak = useCallback(() => Speech.stop(), []);

  const value = useMemo(() => ({
    lang, setLang, tr, speak, stopSpeak, pickerOpen, setPickerOpen, languages: LANGUAGES,
  }), [lang, tr, speak, stopSpeak, pickerOpen]);

  return <LanguageContext.Provider value={value}>{children}</LanguageContext.Provider>;
}

export function useLang() {
  const ctx = useContext(LanguageContext);
  if (!ctx) throw new Error('useLang must be used within LanguageProvider');
  return ctx;
}
