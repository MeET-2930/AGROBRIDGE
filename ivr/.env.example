# copy to .env for local testing (never commit .env)
PORT=3000
BASE_URL=https://agrobridge-ivr.onrender.com
FIREBASE_SERVICE_ACCOUNT_B64=   # base64 of the service-account JSON (see README)
APP_SHARED_KEY=agb-demo-2026

# sim    = browser phone at BASE_URL/sim  (default, nothing else needed)
# plivo  = real number from Plivo   (needs the 3 PLIVO_* values)
# twilio = real number from Twilio  (needs the 3 TWILIO_* values)
PROVIDER=sim

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Google AI Studio key for the chatbot agent (server-side only - never
# ship it in the app bundle). Optional for chatbot-local.js FAQ-only mode.
GEMINI_API_KEY=
# Optional model override for the assistant (default: gemini-3.1-flash-lite)
GEMINI_MODEL=
# Opt-in: set to true to enforce the x-agb-key shared-secret guard on
# /chat + /translate. Leave false until the app build sends x-agb-key.
CHATBOT_REQUIRE_KEY=false
# Server-side kill switch for real chat bookings. Set false for public
# deployments until Firebase Auth token verification is in place.
CHATBOT_ALLOW_BOOKING=true
