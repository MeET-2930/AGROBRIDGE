# copy to .env for local testing (never commit .env)
PORT=3000
BASE_URL=https://agrobridge-ivr.onrender.com
FIREBASE_SERVICE_ACCOUNT_B64=   # base64 of the service-account JSON (see README)
APP_SHARED_KEY=agb-demo-2026

PROVIDER=plivo                  # plivo | twilio
PLIVO_AUTH_ID=MAXXXXXXXXXXXXXXXXXX
PLIVO_AUTH_TOKEN=xxxxxxxx
PLIVO_FROM=+1xxxxxxxxxx         # your rented Plivo number

# only if PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
